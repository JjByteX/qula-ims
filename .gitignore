# Dependencies
node_modules/

# Next.js build output
.next/
out/

# Environment variables — real secrets never get committed.
# .env.example is intentionally NOT ignored below; it's the template.
.env
.env.local
.env.*.local
.env.production
.env.development

# Local-disk storage driver (lib/storage/local.ts), used automatically
# when R2 isn't configured. Keep the folder (via public/uploads/.gitkeep)
# but not anyone's local test uploads.
/public/uploads/*
!/public/uploads/.gitkeep

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# TypeScript incremental build info
*.tsbuildinfo
next-env.d.ts

# OS files
.DS_Store
Thumbs.db

# Editor directories
.vscode/
.idea/
