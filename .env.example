# Copy this file to .env (or .env.local) and fill in real values.
# cp .env.example .env
#
# Vars marked REQUIRED throw an error at server startup / first use if
# missing — the app won't run without them. Vars marked optional have a
# working fallback and can be left blank. The R2 section below is a
# special case: it's optional for local dev (falls back to local-disk
# storage automatically) but required for anything beyond that.

# --- Database (REQUIRED) --------------------------------------------------
# Postgres connection string. Used by db/client.ts, db/seed.ts,
# db/migrate.ts, and drizzle.config.ts.
DATABASE_URL=postgres://user:password@localhost:5432/qula_ims

# --- Cloudflare R2 object storage (optional for local dev) ---------------
# Used for every file upload in the app: profile pictures, payment QR
# codes, payment signatures, and uploaded invoice/AR documents
# (lib/storage/client.ts, lib/storage/upload.ts, lib/storage/local.ts).
#
# Leave all five of these blank to run locally with zero storage setup —
# uploads are automatically written to public/uploads and served from
# there instead. This only works for local dev (that folder isn't a real
# persistent object store); fill in real R2 values below before deploying
# anywhere that matters.
#
# All five are required together once you do set them — from the
# Cloudflare dashboard: R2 > Manage API Tokens > create a token scoped to
# your bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# The public hostname uploaded files are served from (your bucket's
# public R2.dev domain, or a custom domain if you've set one up in
# Cloudflare). Example: pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
R2_PUBLIC_HOSTNAME=

# --- Email (REQUIRED) ------------------------------------------------------
# Resend API key, used for registration and password-reset emails
# (lib/email/client.ts). Throws at import time if missing, same pattern
# as the R2 vars above.
RESEND_API_KEY=

# Sender address for outgoing emails. Optional — falls back to
# "Qula IMS <no-reply@example.com>" if left blank, which works for local
# dev but should be a real verified sender in production.
EMAIL_FROM=

# --- App (optional) --------------------------------------------------------
# Base URL used to build links inside emails (registration approval,
# password reset). Optional — falls back to http://localhost:3000, which
# is correct for local dev. Set this to your real domain in production so
# emailed links don't point at localhost.
APP_URL=
