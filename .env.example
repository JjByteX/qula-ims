# ============================================================
# Qula IMS — Environment Variables
# Copy this file to .env and fill in real values.
# ============================================================

# --- Database (PostgreSQL) ---
# Local dev via Docker Compose uses the values below by default.
DATABASE_URL=postgres://qula:qula@localhost:5432/qula_ims

# --- Auth / Sessions ---
# Random 32+ char secret used to sign session-related tokens (reset tokens, etc).
AUTH_SECRET=replace-with-a-long-random-string

# Base URL of the app, used to build links in emails (password reset, etc).
APP_URL=http://localhost:3000

# --- Email (password reset links) ---
# Resend is the default provider. Get a key at https://resend.com
RESEND_API_KEY=
EMAIL_FROM="Qula IMS <no-reply@yourdomain.com>"

# --- File storage (Cloudflare R2, S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=qula-ims
# Public hostname used to build image/file URLs, e.g. pub-xxxx.r2.dev
R2_PUBLIC_HOSTNAME=

# --- Monitoring (optional, wired in Phase 7) ---
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
